[alias]
	br = "branch"
	ci = "commit"
	co = "checkout"
	st = "status"

[column]
	ui = auto

[core]

[diff]
	algorithm = "histogram"
	colormoved = "default"
	colormovedws = "allow-indentation-change"

[diff "sqlite3"]
	binary = true
	textconv = "echo .dump | sqlite3"

[fetch]
	fsckobjects = true
	prune = true
	prunetags = true

[init]
	defaultBranch = "main"

[merge]
	conflictStyle = "zdiff3"

[push]
	autoSetupRemote = true

[receive]
	fsckobjects = true

[transfer]
	fsckobjects = true

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
